{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["vitest/globals", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // worker-configuration.d.ts (generated by `wrangler types`, run again
  // whenever wrangler.jsonc's bindings change) supersedes
  // @cloudflare/workers-types — Cloudflare's own runtime type generation,
  // recommended by wrangler 4's own migration notice.
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"]
}
