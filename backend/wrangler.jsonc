{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeroup-reads-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Real Google OAuth client (console.cloud.google.com/apis/credentials) -
    // GOOGLE_OAUTH_CLIENT_SECRET is set separately via `wrangler secret put`,
    // never here, since this file is committed. See backend/README.md's
    // OAuth (Google) section.
    "GOOGLE_OAUTH_CLIENT_ID": "525728563081-n4qfg8k28kl6j050eaos6ji6orjhnp2f.apps.googleusercontent.com",
    "OAUTH_REDIRECT_BASE_URL": "https://zeroup-reads-api.bridegai.workers.dev",
    "OAUTH_FRONTEND_REDIRECT_URL": "https://zeroup-reads.pages.dev/oauth/callback"
  },
  // Real D1 database, created under the zeroupacademy@gmail.com Cloudflare
  // account via `wrangler d1 create zeroup-reads-db` (region WEUR). Schema
  // still needs to be applied with `wrangler d1 migrations apply
  // zeroup-reads-db --remote` before this is queryable.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeroup-reads-db",
      "database_id": "48e57c0b-7bd0-4a01-afe2-c0416bd62701"
    }
  ],
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      },
      // Still a placeholder — no separate staging database exists yet.
      // Run `wrangler d1 create zeroup-reads-db-staging` and drop its real
      // id here if/when a staging environment is actually needed.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zeroup-reads-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ]
    }
  }
}
